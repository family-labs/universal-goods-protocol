{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Universal Goods marketplace: open public read API",
    "version": "1.0.0",
    "summary": "Read-only, free and open: the items for sale on the Universal Goods marketplace.",
    "description": "Anyone can read the listings that are for sale, with no account and no API key: people, search engines and AI agents. Each listing links to its digital product passport and to the chain, so you can check the passport and who holds it yourself. Prices are in Australian dollars and include the 3% buyer fee; shipping is quoted at checkout. The API never publishes the seller's personal data or the item's printed code. Reads are rate limited per address (60 a minute and 1,200 an hour for listings; photos have their own, larger allowance). Buying, payments and orders are a separate, private service operated by Family Labs Pty Ltd and are not part of this API.",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    },
    "contact": {
      "name": "Family Labs Pty Ltd",
      "url": "https://universalgoods.org"
    }
  },
  "servers": [
    {
      "url": "https://api.universalgoods.xyz/api/marketplace/v1/public",
      "description": "TESTNET ONLY: LUKSO testnet (chain 4201), payments in Stripe test mode. Nothing here is really for sale."
    }
  ],
  "paths": {
    "/listings": {
      "get": {
        "operationId": "searchListings",
        "summary": "Search and filter the listings for sale",
        "description": "Newest first unless `sort` says otherwise. Page with `nextCursor`.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Words to look for in the listing's title, brand, category and the seller's description (at most 100 characters). It never matches an item's code, serial number or token id.",
            "schema": {
              "type": "string",
              "maxLength": 100
            }
          },
          {
            "name": "brand",
            "in": "query",
            "required": false,
            "description": "A brand's id (`brand.id` in a listing).",
            "schema": {
              "type": "string",
              "maxLength": 100
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "A category slug (`category.slug`, or its parent's slug).",
            "schema": {
              "type": "string",
              "maxLength": 100
            }
          },
          {
            "name": "condition",
            "in": "query",
            "required": false,
            "description": "One or more conditions, comma separated.",
            "schema": {
              "type": "string",
              "pattern": "^(new_with_tags|excellent|good|fair)(,(new_with_tags|excellent|good|fair))*$"
            }
          },
          {
            "name": "minPriceCents",
            "in": "query",
            "required": false,
            "description": "The lowest price a buyer pays, in cents, buyer fee included.",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "maxPriceCents",
            "in": "query",
            "required": false,
            "description": "The highest price a buyer pays, in cents, buyer fee included.",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "shipsFrom",
            "in": "query",
            "required": false,
            "description": "The country it ships from, ISO 3166-1 alpha-2 (for example AU).",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z]{2}$"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "`newest` (default), `price_asc` or `price_desc`.",
            "schema": {
              "type": "string",
              "enum": [
                "newest",
                "price_asc",
                "price_desc"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Listings per page, 1 to 50 (default 24).",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "The `nextCursor` of the previous page. Opaque; pass it back unchanged with the same filters and sort.",
            "schema": {
              "type": "string",
              "maxLength": 400
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of listings.",
            "headers": {
              "Cache-Control": {
                "description": "How long the answer may be cached.",
                "schema": {
                  "type": "string"
                }
              },
              "ETag": {
                "description": "A validator; send it back as If-None-Match for a 304.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListingPage"
                }
              }
            }
          },
          "400": {
            "description": "A parameter was not understood.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "The marketplace is not open here.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many reads from your address. Wait for Retry-After seconds.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/listings/{id}": {
      "get": {
        "operationId": "getListing",
        "summary": "One listing, with a fresh on-chain owner check",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The listing.",
            "headers": {
              "Cache-Control": {
                "description": "How long the answer may be cached.",
                "schema": {
                  "type": "string"
                }
              },
              "ETag": {
                "description": "A validator; send it back as If-None-Match for a 304.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Listing"
                }
              }
            }
          },
          "404": {
            "description": "No listing with that id is for sale.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many reads from your address. Wait for Retry-After seconds.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/listings/{id}/jsonld": {
      "get": {
        "operationId": "getListingJsonLd",
        "summary": "The listing as schema.org JSON-LD (Product and Offer)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "schema.org Product with an Offer.",
            "headers": {
              "Cache-Control": {
                "description": "How long the answer may be cached.",
                "schema": {
                  "type": "string"
                }
              },
              "ETag": {
                "description": "A validator; send it back as If-None-Match for a 304.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/ld+json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonLdProduct"
                }
              }
            }
          },
          "404": {
            "description": "No listing with that id is for sale.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many reads from your address. Wait for Retry-After seconds.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/listings/{id}/photos/{photoId}": {
      "get": {
        "operationId": "getListingPhoto",
        "summary": "One of the seller's photos (JPEG, location data removed)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "photoId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The photo.",
            "headers": {
              "Cache-Control": {
                "description": "How long the answer may be cached.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "contentMediaType": "image/jpeg"
                }
              }
            }
          },
          "404": {
            "description": "No such photo on a listing that is for sale.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many reads from your address. Wait for Retry-After seconds.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
